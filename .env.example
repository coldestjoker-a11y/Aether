# Default to Ethereum Mainnet ("false" = Mainnet Default, "true" = Sepolia Default)
NEXT_PUBLIC_DEV_TESTNET_DEFAULT=false

# STRICTLY SERVER-ONLY (Never exposed to browser JS bundle - minimum 16 characters required)
ADMIN_PASSCODE=replace_with_your_own_secure_admin_passcode_minimum_16_chars
ADMIN_SESSION_SECRET=replace_with_your_own_secure_random_hmac_secret_minimum_16_chars

# Production RPC Providers (Alchemy & Infura HTTP + WSS for Mainnet reliability)
NEXT_PUBLIC_ALCHEMY_KEY=your_alchemy_api_key_here
NEXT_PUBLIC_INFURA_KEY=your_infura_api_key_here

# Web3 & Aggregators
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_wc_v2_project_id
NEXT_PUBLIC_ZEROX_API_KEY=your_0x_api_key_here
NEXT_PUBLIC_LIFI_INTEGRATOR=aethervault-mainnet
