# Default to Sepolia Testnet ("true" or "false")
NEXT_PUBLIC_DEV_TESTNET_DEFAULT=true

# Standalone /admin Portal Passcode (Default fallback: admin2026)
NEXT_PUBLIC_ADMIN_PASSCODE=admin2026

# RPC Providers (Alchemy & Infura for automatic fallback)
NEXT_PUBLIC_ALCHEMY_KEY=your_alchemy_api_key_here
NEXT_PUBLIC_INFURA_KEY=your_infura_api_key_here

# Web3 & Aggregators
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_wc_v2_project_id
NEXT_PUBLIC_ZEROX_API_KEY=your_0x_api_key_here
NEXT_PUBLIC_LIFI_INTEGRATOR=aethervault-pwa

# Fiat On-Ramp
NEXT_PUBLIC_TRANSAK_API_KEY=your_transak_staging_or_prod_key
